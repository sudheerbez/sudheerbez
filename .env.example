# Set these in Netlify UI (Site → Environment variables). Do not commit real values.

WHATSAPP_VERIFY_TOKEN=invent-a-long-random-string
# Must be Meta App Secret from App settings → Basic (short hex), NOT an EAAV access token
WHATSAPP_APP_SECRET=your-meta-app-secret

META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Optional. Leave unset unless you have a separate agent app to redirect to.
# Do NOT set this to your own /api/meta/oauth/callback URL.
# META_OAUTH_SUCCESS_URL=
