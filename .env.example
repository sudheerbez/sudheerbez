# Netlify Environment Variables — set in the Netlify UI only (never commit secrets)
#
# Site → Site configuration → Environment variables
#
# WHATSAPP_VERIFY_TOKEN=your-invented-string
# WHATSAPP_APP_SECRET=meta-app-secret
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=meta-app-secret
# META_OAUTH_SUCCESS_URL=https://your-agent-app.example/whatsapp/connected
# WHATSAPP_ACCESS_TOKEN= (add later for AI replies)
# WHATSAPP_PHONE_NUMBER_ID= (add later for AI replies)
