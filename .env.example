# Meta WhatsApp Cloud API webhook (Netlify Functions — server-side only)
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# Meta OAuth redirect (Facebook Login / Embedded Signup)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Optional: send the user back to your agent app after OAuth
META_OAUTH_SUCCESS_URL=https://your-agent-app.example/whatsapp/connected
